# Optional: more Bible translations (personal use). Copy this file to .env,
# fill in the keys you have, then restart `npx expo start`.
# Steps for each key are in docs/LICENSED_TRANSLATIONS.md.

# ESV: free key from https://api.esv.org
EXPO_PUBLIC_ESV_API_KEY=

# NLT: free key from https://api.nlt.to (works lightly without one)
EXPO_PUBLIC_NLT_API_KEY=

# NIV, NKJV, CSB, NASB: free key from https://scripture.api.bible
EXPO_PUBLIC_API_BIBLE_KEY=
